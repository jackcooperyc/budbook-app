# Optional: Google Maps Embed API key for dispensary map
# Without this, a standard Google Maps embed fallback is used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Neon Postgres (production). When unset, file-backed stores in ./data are used locally.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Session auth (production recommended). When set, /budbook-app requires email sign-in.
# BUDBOOK_AUTH_SECRET=generate-with-openssl-rand-hex-32

# Optional: OpenAI for Buddy LLM replies (falls back to rule-based coach without this).
# BUDBOOK_OPENAI_API_KEY=
# BUDBOOK_OPENAI_MODEL=gpt-4o-mini

# RDA shop cache TTL in ms (default 24h). Stale cache re-seeds from adapter.
# RDA_CACHE_TTL_MS=86400000

# Optional: override file-backed store directory (default: ./data locally, /tmp/budbook-data on Vercel)
# BUDBOOK_DATA_DIR=/var/budbook/data
# BUDBOOK_USER_NAME=BudBook User
# BUDBOOK_USER_USERNAME=budbookuser
# BUDBOOK_USER_EMAIL=dev@budbook.local
