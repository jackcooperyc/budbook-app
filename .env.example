# Optional: Google Maps Embed API key for dispensary map
# Without this, a standard Google Maps embed fallback is used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional: override file-backed store directory (default: ./data locally, /tmp/budbook-data on Vercel)
# BUDBOOK_DATA_DIR=/var/budbook/data
# BUDBOOK_USER_NAME=BudBook User
# BUDBOOK_USER_USERNAME=budbookuser
# BUDBOOK_USER_EMAIL=dev@budbook.local
