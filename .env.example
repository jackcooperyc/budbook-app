# Optional: Google Maps Embed API key for dispensary map
# Without this, a standard Google Maps embed fallback is used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Neon Postgres (production). When unset, file-backed stores in ./data are used locally.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Session auth (production recommended). When set, /pacs requires email sign-in.
# PACSMT_AUTH_SECRET=generate-with-openssl-rand-hex-32

# Optional: OpenAI for PACS Assistant LLM replies (falls back to rule-based coach without this).
# PACSMT_OPENAI_API_KEY=
# PACSMT_OPENAI_MODEL=gpt-4o-mini

# RDA shop cache TTL in ms (default 24h). Stale records are marked low-confidence, not deleted.
# RDA_CACHE_TTL_MS=86400000

# Operator shop import (production). Protects POST /api/internal/rda/import.
# RDA_IMPORT_SECRET=generate-with-openssl-rand-hex-32

# Operator Learn CMS import (production). Protects POST /api/internal/learn/import.
# LEARN_IMPORT_SECRET=generate-with-openssl-rand-hex-32

# Optional: override file-backed store directory (default: ./data locally, /tmp/pacsmt-data on Vercel)
# PACSMT_DATA_DIR=/var/pacsmt/data
# PACSMT_USER_NAME=Pacs.MT User
# PACSMT_USER_USERNAME=pacsmt
# PACSMT_USER_EMAIL=dev@pacsmt.local

# Optional Metrc (Montana) live package lookup
# METRC_BASE_URL=https://api-mt.metrc.com
# METRC_USER_KEY=
# METRC_VENDOR_KEY=
